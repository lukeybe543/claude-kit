# systemd --user unit for the desktop notification listener.
#
#   mkdir -p ~/.config/systemd/user
#   cp desk-listener.service ~/.config/systemd/user/
#   # check ExecStart below points at this file's real location on this machine
#   systemctl --user daemon-reload
#   systemctl --user enable --now desk-listener
#   loginctl enable-linger "$USER"          # so it runs when you are not logged in
#
# See README.md for how the dev box reaches it (tailnet or reverse SSH forward).

[Unit]
Description=Claude Code hook notification listener (plays sounds forwarded from the dev box)
After=network.target

[Service]
# NOTIFY_LISTEN_ADDR=0.0.0.0 so a tailnet peer can reach it; drop to 127.0.0.1
# if you use a reverse SSH forward instead.
Environment=NOTIFY_LISTEN_ADDR=0.0.0.0
ExecStart=/usr/bin/python3 %h/Sync/Code/claude-kit/hooks/desk-listener/listener.py
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
