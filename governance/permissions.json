{
  "_comment": [
    "A baseline that lets safe work run in a loop and stops at anything that touches the",
    "system. Merged into a project's .claude/settings.json by install.py, which adds only",
    "rules that are not already there. Tune per project -- these are a starting point, not",
    "a policy.",
    "",
    "defaultMode acceptEdits lets file edits happen without a prompt: they are covered by",
    "tests and undone with git. Bash still prompts unless a rule below allows it."
  ],
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-attr:*)",
      "Bash(git check-ignore:*)",
      "Bash(git add:*)",
      "Bash(git stash list:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(wc:*)",
      "Bash(file:*)",
      "Bash(date:*)",
      "Bash(which:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m ruff:*)",
      "Bash(python -m mypy:*)",
      "Bash(python -c:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npx tsc:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git worktree:*)",
      "Bash(pip:*)",
      "Bash(python -m pip:*)",
      "Bash(npm install:*)",
      "Bash(npm publish:*)",
      "Bash(docker:*)",
      "Bash(systemctl:*)",
      "Bash(mv:*)",
      "Bash(cp:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git filter-branch:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/*_api_key*)",
      "Read(**/credentials*)"
    ]
  }
}
